# Ẹgbẹ́ Bobagunwa platform — environment template.
# Copy to .env for each environment. Never commit .env or real secrets.
APP_NAME="Ẹgbẹ́ Bobagunwa"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# MariaDB 11.4 / InnoDB (Namecheap cPanel database and dedicated user).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bobagunwa
DB_USERNAME=boba
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Optional SMTP through the association's existing hosting mailbox.
# Leave MAIL_MAILER=log to use the administrator-assisted delivery workflow only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bobagunwa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Backups: X25519 public key only. The matching secret key is held off-server
# by the approved custodian and is supplied only at restore time.
BOBA_BACKUP_PUBLIC_KEY=
BOBA_BACKUP_PATH=

# Force HTTPS URLs and HSTS (set true on staging/production with valid TLS).
BOBA_FORCE_HTTPS=false
