# Staging (protected, synthetic data only). Copy to .env on the server, outside the webroot.
APP_NAME="Ẹgbẹ́ Bobagunwa (staging)"
APP_ENV=staging
APP_KEY=                # php artisan key:generate --show (unique per environment)
APP_DEBUG=false
APP_URL=https://v2-staging.bobagunwa.com
LOG_CHANNEL=daily
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=            # dedicated cPanel staging database
DB_USERNAME=            # dedicated cPanel user with privileges on that database only
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # requires a VALID certificate for the staging hostname
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BOBA_BACKUP_PUBLIC_KEY=        # custodian public key (boba:backup:keygen on a trusted computer)
BOBA_BACKUP_PATH=              # absolute path outside public_html, e.g. /home/<cpanel-user>/bobagunwa-backups/staging
BOBA_FORCE_HTTPS=true
BOBA_TRUSTED_PROXIES=127.0.0.1
