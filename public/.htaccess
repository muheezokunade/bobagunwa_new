# Ẹgbẹ́ Bobagunwa — Apache/LiteSpeed rules for the application webroot.
Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional HTTPS redirect. Enable ONLY once a valid certificate is installed
    # for this hostname (see docs/09-deployment-runbook.md, step 9).
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Never serve dotfiles (.env, .git, .htaccess) or backup/source artefacts.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(env|log|sql|bak|bobabk|key|ini|lock|md|sh)$ - [F,L,NC]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=308,NE]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Long-lived caching for fingerprinted build assets only.
    <FilesMatch "\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
